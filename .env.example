# HTTP port for Steward Manual (open http://localhost:<PORT>/).
PORT=3000

# ── Google OAuth (optional) ────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
# Set the authorized redirect URI to: http://localhost:3000/api/auth/google/callback
# If these are not set, the "Sign in with Google" button will be hidden.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
