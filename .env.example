# HTTP port for Steward Manual (open http://localhost:<PORT>/).
PORT=3000

# Public base URL used inside outgoing emails (password reset links).
# Set this to the URL users will click — http://localhost:3000 for local dev,
# https://your-domain for production.
APP_BASE_URL=http://localhost:3000

# ── Google OAuth (optional) ────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
# Add EVERY base URL you serve from as an authorized redirect URI:
#   http://localhost:3000/api/auth/google/callback        (local dev)
#   https://<your-domain>/api/auth/google/callback        (production)
# If client id/secret are not set, the "Sign in with Google" button is hidden.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional override. Defaults to <APP_BASE_URL>/api/auth/google/callback, so a
# deploy that sets APP_BASE_URL correctly doesn't need this at all.
GOOGLE_REDIRECT_URI=

# ── Password reset email (optional) ────────────────────────────────────────
# When RESEND_API_KEY is set, /api/auth/forgot-password dispatches via Resend
# (https://resend.com — REST API, generous free tier). When unset, the reset
# link is printed to the server console — fine for local dev / single-user.
# EMAIL_FROM must be a sender on a Resend-verified domain in production. The
# default "onboarding@resend.dev" only delivers to your Resend account owner.
RESEND_API_KEY=
EMAIL_FROM=Steward <onboarding@resend.dev>

# ── One-off opt-out for required email at registration (optional) ──────────
# Set to 1 to allow new local accounts without an email (legacy / dev path).
# Default behavior requires email so the user can reset their password later.
STEWARD_ALLOW_REGISTER_WITHOUT_EMAIL=

# ── Steward AI (optional) ──────────────────────────────────────────────────
# When ANTHROPIC_API_KEY is set, fresh snapshots trigger a short Pennybags-
# voiced dialog (and accumulate a one-line journal entry per turn) via the
# Anthropic Messages API. Unset → /api/steward-ai/comment returns 204 and the
# UI closes its dialog silently. Get a key at https://console.anthropic.com.
ANTHROPIC_API_KEY=
# Optional model override. Defaults to claude-sonnet-4-6. Use
# claude-haiku-4-5-20251001 if you want to spend even fewer tokens per turn.
STEWARD_AI_MODEL=

# ── Database path (REQUIRED in production) ─────────────────────────────────
# SQLite file location. In dev this defaults to ./steward.db.
# In production on Railway/Render/Fly the container filesystem is ephemeral,
# so every redeploy WIPES the database unless this is set to a mounted volume.
#   Railway: create a Volume, mount it at /data, then set:
#     STEWARD_DB_PATH=/data/steward.db
#   Fly.io:  fly volumes create steward_data, mount at /data, same value.
STEWARD_DB_PATH=

# ── Backups ─────────────────────────────────────────────────────────────────
# Long random secret protecting GET /admin/backup, which streams a consistent
# copy of the live SQLite DB. Pull it from another machine on a schedule for
# an off-site backup (see scripts/pull-backup.ps1). Unset → endpoint disabled.
# Production also writes a daily on-volume snapshot to <db-dir>/backups/
# (keeps 7) regardless of this setting.
STEWARD_BACKUP_TOKEN=

# ── Node environment ───────────────────────────────────────────────────────
# Set to "production" on hosted deploys. Enables Secure session cookies,
# trust-proxy for X-Forwarded-* headers, and the persistent-DB warning.
NODE_ENV=
