{
  "name": "steward-manual",
  "version": "1.19.0",
  "description": "Manual debt payoff dashboard — enter your own numbers, same gamified climb system",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node test/run-all.js",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "reset-local-data": "node -e \"require('./db').resetAllGameState(); console.log('All game state cleared.');\"",
    "audit:metrics": "node scripts/audit-metrics.js",
    "test:visual": "VISUAL=1 playwright test e2e/visual.spec.js",
    "test:visual:update": "VISUAL=1 playwright test e2e/visual.spec.js --update-snapshots"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "express": "^4.22.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.60.0"
  }
}
